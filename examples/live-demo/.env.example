# Muretto live demo (optional): copy to examples/live-demo/.env (git-ignored) and fill in.
#
#   cp examples/live-demo/.env.example examples/live-demo/.env && chmod 600 examples/live-demo/.env
#
# Use TEST accounts only: a dedicated Supabase org with 1-2 pre-created
# projects, and a dedicated Vercel team. The demo agents create, and
# examples/live-demo/reset.sh deletes, real resources in these accounts. Muretto itself
# never writes; only the agents and these demo scripts do. Each run also
# spends Claude usage (five sessions, capped by DEMO_MAX_BUDGET_USD below).
#
# Every value below is a fake. Never commit the real file.

# ---------------------------------------------------------------- guard
# Must be exactly 1, or every script refuses to run.
MURETTO_DEMO=0

# ---------------------------------------------------------------- Supabase
# Primary test project (alice and bob use it; prove.sh curls it). The ref is
# the 20-letter id in https://<ref>.supabase.co. Destructive steps make you
# type it to confirm.
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
# Optional second test project (carol and dan use it). Leave empty to put
# every session on the primary project. Free plan: 2 active projects per user.
SUPABASE_PROJECT_REF_2=

# Personal access token (sbp_...) of a member of the TEST org. The agents'
# Supabase MCP server uses it to create tables, functions and buckets, and
# setup.sh / reset.sh use it for the Management API. It can write.
SUPABASE_ACCESS_TOKEN=sbp_example0000000000000000000000000000000

# Token Muretto itself reads with (read-only by Muretto's broker). Prefer a
# fine-grained token with read scopes only (adapters/supabase/research.md Q2).
# Empty = reuse SUPABASE_ACCESS_TOKEN (run.sh prints a warning).
MURETTO_SUPABASE_TOKEN=

# Publishable key of the PRIMARY project (sb_publishable_...), or the legacy
# anon JWT. prove.sh sends only this key: it is what any browser has.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example000000000000000000

# Secret key (sb_secret_...) of each project, used ONLY by reset.sh to empty
# and delete demo-* storage buckets (the Management API has no bucket delete).
# Empty = reset.sh prints the buckets for you to delete in the dashboard.
SUPABASE_SECRET_KEY=
SUPABASE_SECRET_KEY_2=

# ---------------------------------------------------------------- Vercel
# The TEST team. Its slug must contain "demo" or "test" (a cheap sanity check).
VERCEL_TEAM_ID=team_example000000000000000
VERCEL_TEAM_SLUG=example-demo-team
# Team-scoped access token (vcp_...) for the test team. The Vercel CLI reads it
# from the environment, so agents' commands never contain it; reset.sh uses it
# to delete demo-* projects and their deployments. It can write.
VERCEL_TOKEN=vcp_example000000000000000000000000
# Token Muretto reads with. Vercel has no read-only token
# (adapters/vercel/research.md Q2);
# Muretto's broker is what keeps it read-only. Empty = reuse VERCEL_TOKEN.
MURETTO_VERCEL_TOKEN=

# ---------------------------------------------------------------- Claude Code
# Claude Code uses your normal login (or ANTHROPIC_API_KEY if you set it in
# your shell; never put it here unless you mean to).
# Model alias or full id passed to `claude --model`.
DEMO_MODEL=sonnet
# Hard cap per session, passed to `claude --max-budget-usd`. 5 sessions run.
DEMO_MAX_BUDGET_USD=2

# ---------------------------------------------------------------- local
# Local sync server and dashboard ports (127.0.0.1 only).
DEMO_SERVER_PORT=8080
DEMO_WEB_PORT=3000
# Team name created on the local server.
DEMO_ORG_NAME=Example team (demo)
# Seconds between `muretto sync now` rounds in the sixth pane.
DEMO_SYNC_INTERVAL=5
# Seconds between forced re-checks (--refresh) of bob's view, so a change in
# the test project shows up quickly. Muretto's own scan cache is 60 s.
DEMO_REFRESH_INTERVAL=20
