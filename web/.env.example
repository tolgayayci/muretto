# Copy to .env.local. Nothing here is secret.

# Where the Go sync API runs. /api/* is proxied here (read at build time for `next build`).
MURETTO_API_URL=http://localhost:8080

# Base URL the browser calls. Keep /api (the proxy) in development. In production,
# use the API's own origin on a sibling subdomain, e.g. https://api.example.com
NEXT_PUBLIC_MURETTO_API_BASE=/api

# Set to 1 to render /app from the built-in sample data (no server needed).
# /app/sample always uses sample data, whatever this says.
NEXT_PUBLIC_MURETTO_SAMPLE=0
