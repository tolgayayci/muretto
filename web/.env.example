# Copy to .env.local. Nothing here is secret.

# Where the Go sync API runs. /api/* is proxied here so the session cookie is same-origin.
MURETTO_API_URL=http://localhost:8080

# Set to 1 to render every dashboard route from the built-in sample data (no server needed).
# /app/sample always uses sample data, whatever this says.
NEXT_PUBLIC_MURETTO_SAMPLE=0
