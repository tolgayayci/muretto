    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "node scripts/generate-contract.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "geist": "1.8.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
