{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Muretto",
  "description": "Muretto is an open-source, read-only CLI that shows what AI coding agents created outside the repo, traces each resource to the session that made it, and flags what is open to anyone.",
  "colors": {
    "primary": "#c8f169",
    "light": "#c8f169",
    "dark": "#c8f169"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#0b0b0a",
      "dark": "#0b0b0a"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/muretto.svg",
    "dark": "/logo/muretto.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "how-it-works"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "examples",
          "dashboard"
        ]
      },
      {
        "group": "Providers",
        "pages": [
          "providers",
          "adapters"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "cli",
          "privacy"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/tolgayayci/muretto"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install the CLI",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/tolgayayci/muretto"
    }
  }
}
