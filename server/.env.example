# murettod settings. murettod reads only the process environment, not this file:
# copy it to server/.env (git-ignored) and load it, e.g. `set -a; . server/.env; set +a`.
# Full reference: server/README.md ("Environment variables"). Placeholders only.

# Listen address. Leave unset on Railway: PORT is used (":$PORT").
MURETTO_ADDR=127.0.0.1:8080
# Set by Railway and most hosts; used only when MURETTO_ADDR is unset.
# PORT=8080

# The API's own public base URL; https enables HSTS (http only on loopback).
MURETTO_PUBLIC_URL=http://127.0.0.1:8080
# Dashboard origin: the only CORS origin, and the base of invite and device-approval links.
MURETTO_DASHBOARD_URL=http://localhost:3000

# Supabase project URL (no path). Required unless MURETTO_DEV_LOGIN=1 on loopback.
MURETTO_SUPABASE_URL=https://<project-ref>.supabase.co
# Optional legacy HS256 JWT secret (>= 32 chars). Leave empty on asymmetric signing keys.
MURETTO_SUPABASE_JWT_SECRET=

# Postgres URL; empty = in-memory store (data lost on restart). On Supabase use the session-mode pooler.
MURETTO_DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Connection for LISTEN; defaults to MURETTO_DATABASE_URL. Session mode or direct (port 6543 is refused).
MURETTO_DATABASE_LISTEN_URL=
# pgx pool size; keep it small on the shared pooler.
MURETTO_DB_MAX_CONNS=5

# DEV ONLY: anyone can sign in as anyone. Refused unless the listen address is loopback.
MURETTO_DEV_LOGIN=0
# 1 behind a proxy that appends the client IP to X-Forwarded-For (Railway). Used for per-IP rate limits.
MURETTO_TRUST_PROXY=0
# Ingest body limit in bytes (>= 1024); 413 above it.
MURETTO_MAX_BODY_BYTES=8388608
# Ingest requests per minute per CLI token.
MURETTO_INGEST_PER_MINUTE=30
