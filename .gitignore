# Secrets: never commit these
.env
.env.*
!.env.example
examples/live-demo/.env
examples/live-demo/.run/
*.pem
*.key

# Muretto local state (normally in ~/.muretto, but never commit it if it lands here)
.muretto/
spool/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Local tool state
.wrangler/
.dev.vars*
.mint/
.yk/
# Internal notes stay local only; never commit them.
/docs/
adapters/*/research.md
adapters/*/coverage.md
# Agent instructions and notes are local only; never commit them.
.claude/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
GEMINI.md
.cursor/
.cursorrules
.windsurfrules
.github/copilot-instructions.md

# Build output
/bin/
/dist/
/muretto
*.test
*.out
coverage.*

# Node / Next.js
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
npm-debug.log*

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
