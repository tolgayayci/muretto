# Muretto build tasks. `make test` needs no network access to providers and no accounts.

GO        ?= go
NPM       ?= npm
TOOL      := $(GO) tool -modfile=tools/go.mod
SCHEMAS   := $(wildcard schema/*.schema.json)
BIN       := bin/muretto
VERSION   ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
COMMIT    ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo none)
DATE      ?= $(shell date -u +%Y-%m-%dT%H:%M:%SZ)
LDFLAGS   := -s -w -X main.version=$(VERSION) -X main.commit=$(COMMIT) -X main.date=$(DATE)

.PHONY: all help setup hooks build test adapter-test lint vuln secrets generate check-generate ci npm-pack npm-publish clean

all: build

## help: list the documented targets
help:
	@grep -E '^## ' $(MAKEFILE_LIST) | sed 's/^## /  /'

## setup: install the repo git hooks (secret scan + gofmt before every commit)
setup: hooks
hooks:
	git config core.hooksPath .githooks
	@echo "core.hooksPath values in effect (the last one wins):"
	@git config --show-origin --get-all core.hooksPath || true
	@echo "If another value wins (e.g. a git wrapper passing -c core.hooksPath), run 'make secrets' before committing. CI scans every push."

## build: build bin/muretto from source
build:
	CGO_ENABLED=0 $(GO) build -trimpath -ldflags '$(LDFLAGS)' -o $(BIN) ./cmd/muretto

## test: run the whole Go suite (no network, no accounts)
test:
	$(GO) test -count=1 ./...

## adapter-test: run the adapter gate CI runs; P=<provider> also runs that adapter's strict check
adapter-test:
	$(GO) test -count=1 ./adapters/ -v
ifdef P
	$(GO) run ./cmd/muretto adapter test adapters/$(P)/adapter.yaml --strict
endif

lint:
	@command -v golangci-lint >/dev/null || { echo "golangci-lint v2.14.0 not installed; CI runs it"; exit 0; }
	golangci-lint run

vuln:
	$(TOOL) govulncheck ./...

## secrets: scan the working tree and history for secrets (same as CI)
secrets:
	$(TOOL) gitleaks dir --redact --no-banner .
	$(TOOL) gitleaks git --redact --no-banner .

## generate: Go types from schema/ (TS types are generated by `npm run generate` in apps/dashboard/)
generate:
	$(TOOL) go-jsonschema --only-models -t --capitalization ID --tags json \
		-p contract -o internal/contract/zz_generated.go $(SCHEMAS)
	@if [ -f apps/dashboard/package.json ]; then cd apps/dashboard && npm run --silent generate; fi

check-generate: generate
	git diff --exit-code -- internal/contract apps/dashboard/src/contract

## ci: generated-code check, tests, lint, govulncheck and secret scan
ci: check-generate test lint vuln secrets

## npm-pack: build the npm packages for V=<version> into packaging/npm/.pack (publishes nothing)
npm-pack:
	@test -n "$(V)" || { echo "usage: make npm-pack V=0.1.0"; exit 2; }
	packaging/npm/scripts/pack-local.sh $(V)

## npm-publish: publish packaging/npm/.pack to npm for V=<version>, binaries first
npm-publish:
	@test -n "$(V)" || { echo "usage: make npm-publish V=0.1.0"; exit 2; }
	cd packaging/npm/.pack && for p in muretto-darwin-arm64 muretto-darwin-x64 muretto-linux-arm64 muretto-linux-x64 muretto; do \
		$(NPM) publish ./$$p-$(V).tgz || exit 1; \
	done

clean:
	rm -rf bin dist
